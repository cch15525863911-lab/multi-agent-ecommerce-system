# Docker Compose environment variables
# Copy this file to .env and set real values before running docker-compose up

# PostgreSQL credentials (required)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=ecommerce

# Neo4j credentials (required)
NEO4J_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# LLM API key (required when ECOM_LLM_PROVIDER=cloud)
ECOM_LLM_API_KEY=your_api_key_here

# LLM provider: cloud or vllm
ECOM_LLM_PROVIDER=cloud

# CORS origins (comma-separated)
ECOM_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# HuggingFace token (optional, for vLLM model download)
HUGGING_FACE_HUB_TOKEN=
