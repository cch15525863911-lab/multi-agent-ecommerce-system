# LLM Configuration
# Provider: "cloud" (OpenAI-compatible API) or "vllm" (local vLLM inference)
ECOM_LLM_PROVIDER=cloud
# ⚠️ Set your real API key here — NEVER commit the actual key to version control
ECOM_LLM_API_KEY=
ECOM_LLM_BASE_URL=https://api.deepseek.com/v1
ECOM_LLM_MODEL=deepseek-chat

# vLLM (local LLM inference server, OpenAI-compatible API)
# Start vLLM: docker-compose up vllm  (requires NVIDIA GPU)
ECOM_VLLM_BASE_URL=http://localhost:8001/v1
ECOM_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
ECOM_VLLM_API_KEY=EMPTY

# CORS — comma-separated list of allowed origins
ECOM_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database (PostgreSQL) — ⚠️ set real credentials, do NOT commit
ECOM_DATABASE_URL=postgresql+psycopg2://ecommerce:CHANGE_ME@localhost:5432/ecommerce

# Neo4j (Knowledge Graph) — ⚠️ set real password, do NOT commit
ECOM_NEO4J_URI=bolt://localhost:7687
ECOM_NEO4J_USER=neo4j
ECOM_NEO4J_PASSWORD=

# profile source: redis | kg
ECOM_PROFILE_SOURCE=kg

# A/B Testing
ECOM_AB_TEST_ENABLED=true

# Circuit Breaker (Layer 4 — sliding-window failure detection)
ECOM_CIRCUIT_FAILURE_THRESHOLD=0.5
ECOM_CIRCUIT_WINDOW_SIZE=10
ECOM_CIRCUIT_RECOVERY_TIMEOUT=30.0

# ===== v2.0 新增配置 =====

# Multi-Model Routing — 按任务类型智能选择模型
ECOM_MODEL_ROUTING_ENABLED=true
ECOM_MODEL_FLASH=deepseek-v4-flash        # 简单任务: 快速低成本
ECOM_MODEL_GENERAL=deepseek-v4            # 通用任务: 标准模型
ECOM_MODEL_REASONING=deepseek-reasoner    # 推理任务: 风控/决策

# Intent Router — 意图路由
ECOM_INTENT_ROUTER_USE_LLM=false    # true=LLM识别, false=关键词规则

# Guardrails Gate — 安全网关
ECOM_GUARDRAILS_PROMPT_INJECTION_ENABLED=true
ECOM_GUARDRAILS_PII_ENABLED=true
ECOM_GUARDRAILS_JWT_ENABLED=false    # 默认关闭, 开启后需传 Bearer Token
ECOM_GUARDRAILS_RATE_LIMIT_ENABLED=true
ECOM_JWT_SECRET=dev-secret-change-in-production

# Rate Limiting — 速率限制
ECOM_RATE_LIMIT_USER_PER_MIN=60     # 每用户每分钟请求数
ECOM_RATE_LIMIT_IP_PER_MIN=300      # 每IP每分钟请求数

# Tracing — 链路追踪
ECOM_TRACING_ENABLED=true
ECOM_TRACING_MAX_TRACES=1000

# Workflow Engine — 工作流引擎
ECOM_WORKFLOW_ENABLED=true

# Agent 超时 — 风控类
ECOM_AGENT_TIMEOUT_FRAUD=8.0
ECOM_AGENT_TIMEOUT_CREDIT=8.0
ECOM_AGENT_TIMEOUT_REFUND=8.0
